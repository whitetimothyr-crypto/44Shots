# Tier 2 Audit — API Keys
# Copy this file to .env.audit and fill in real values.
# .env.audit is gitignored; this template is committed.
#
# All three keys required for full multi-judge panel.
# Get keys from:
#   Anthropic:  https://console.anthropic.com/settings/keys
#   Google:     https://aistudio.google.com/apikey
#   OpenAI:     https://platform.openai.com/api-keys

ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GOOGLE_MODEL=gemini-2.5-pro
# OPENAI_MODEL=gpt-4o
# AUDIT_TARGET_URL=https://44shots.com
