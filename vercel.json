{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "felix-tracker-nu.vercel.app" }
      ],
      "destination": "https://44shots.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.44shots.com" }
      ],
      "destination": "https://44shots.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
